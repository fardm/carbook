# Supabase — copy this file to `.env.local` and fill in your project values.
# NEVER put the service-role/secret key here — only the public publishable
# (anon) key may be used in frontend code. Row Level Security protects data.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_ANON_KEY
